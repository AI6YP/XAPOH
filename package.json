{
  "name": "xapoh",
  "version": "0.1.0",
  "description": "XAPOH web page",
  "scripts": {
    "clean": "rm -rf src/.observablehq/cache docs/*",
    "build": "observable build && cp extra/.* docs/",
    "dev": "observable preview",
    "deploy": "observable deploy",
    "observable": "observable"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "main": "observablehq.config.js",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "@drom/eslint-config": "^0.12.0",
    "@observablehq/framework": "1.13.3",
    "eslint": "^8.57.1",
    "esptool-js": "^0.5.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI6YP/XAPOH.git"
  },
  "author": "Aliaksei Chapyzhenka",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AI6YP/XAPOH/issues"
  },
  "homepage": "https://github.com/AI6YP/XAPOH#readme",
  "eslintConfig": {
    "extends": "@drom/eslint-config/eslint8/node12",
    "parserOptions": {
      "sourceType": "module"
    }
  }
}
