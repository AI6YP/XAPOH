{
  "name": "XAPOH-web4",
  "version": "1.0.0",
  "description": "XAPOH web4 — standalone programmer: ESP32-C6 bridge + 3 CH32V003 expanders (via ESP SWIO trigger)",
  "license": "MIT",
  "author": "AI6YP",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "eslint bin lib",
    "build": "node ./bin/build.js -v",
    "watch": "node ./bin/watch.js -v -r bin/build.js lib/ package.json ../sw-v4/main.c ../sw-panel-v4/lib/"
  },
  "eslintConfig": {
    "extends": "@drom/eslint-config/eslint8/node12",
    "parserOptions": {
      "sourceType": "module"
    }
  },
  "devDependencies": {
    "@drom/eslint-config": "^1.0.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "js-md5": "^0.8.3",
    "esptool-js": "^0.6.0",
    "onml": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
